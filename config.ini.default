[main]
api_url_for_virtuoso = http://localhost:8000
souslesens_api_url = http://localhost:3010/api/v1
log_level = info
get_rdf_graph_method = api
post_rdf_graph_method = api
chunk_size = 10_000_000

[virtuoso]
driver  = /usr/local/virtuoso-opensource/lib/virtodbc_r.so
sparql_url = http://localhost:8890/sparql
host = localhost
isql_port = 1111
user = dba
password = dba

[cors]
origins = localhost,127.0.0.1
allowed_methods = GET,POST,DELETE
allowed_headers = *
allowed_credentials = yes

[rdf]
batch_size = 10000
